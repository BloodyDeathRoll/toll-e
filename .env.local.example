# Local development environment. Do not commit real secrets.
DATABASE_URL=postgres://toll-e:toll-e@127.0.0.1:5432/toll-e
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth — the only way to sign in. Without these the sign-in button
# returns PROVIDER_NOT_FOUND; create a Web application client at
# https://console.cloud.google.com/apis/credentials with redirect URI
# http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local/CI only: enables password sign-in so the Playwright suite can run.
# Production is Google-only; lib/auth.ts ignores this when VERCEL_ENV=production.
E2E_TEST_AUTH=1
